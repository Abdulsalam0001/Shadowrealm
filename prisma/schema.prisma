generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderType {
  PRODUCT
  MEMBERSHIP
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAYMENT_SUBMITTED
  CONFIRMING
  PAID
  PAYMENT_REVIEW
  FULFILLMENT_PENDING
  FULFILLED
}

enum PaymentAsset {
  BTC
  ETH
}

enum PaymentStatus {
  AWAITING_PAYMENT
  SUBMITTED
  CONFIRMING
  PAID
  REVIEW
  FULFILLED
}

enum FulfillmentMode {
  MANUAL
  AUTO
}

enum MediaSubmissionStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  membershipPaidAt DateTime?
  orders       Order[]
}

model Product {
  id              String          @id @default(cuid())
  sku             String          @unique
  name            String
  description     String
  priceNgn        Int
  active          Boolean         @default(true)
  fulfillmentMode FulfillmentMode @default(MANUAL)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customerEmail   String
  customerToken   String      @unique
  totalNgn        Int
  type            OrderType    @default(PRODUCT)
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status          OrderStatus @default(AWAITING_PAYMENT)
  fulfillmentNote String?
  fulfilledAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
  payment         CryptoPayment?
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  productSku   String
  productName  String
  quantity     Int
  unitPriceNgn Int
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CryptoPayment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  asset          PaymentAsset
  address        String
  expectedAtomic String
  expectedAmount String
  txHash         String?       @unique
  paidAtomic     String?
  status         PaymentStatus @default(AWAITING_PAYMENT)
  confirmations  Int           @default(0)
  lastCheckedAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model MediaSubmission {
  id              String                @id @default(cuid())
  reference       String                @unique
  journalistName  String
  journalistEmail String
  journalistPhone String?
  role            String
  publicationName String
  articleUrl      String
  package         String
  timing          String
  summary         String
  budget          String?
  consentAt       DateTime
  status          MediaSubmissionStatus @default(PENDING)
  adminNote       String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([journalistEmail, createdAt])
}

model BennyInquiry {
  id        String   @id @default(cuid())
  reference String   @unique
  alias     String?
  contact   String?
  service   String
  budget    String?
  message   String
  consentAt DateTime
  status    String   @default("NEW")
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}
